 cat .gitignore
# Compiled class files
*.class

# Log files
*.log

# OS-specific files
.DS_Store
Thumbs.db

# IDE files
.idea/
*.iml
.vscode/
*.project

# Build output
/target/
build/
out/

# Temporary files
*.tmp
*.swp

# Package files
*.jar
*.ear
*.war

# Dependency directories
.lib/
dependency-reduced-pom.xml

# Maven files
.mvn/
!mvn/wrapper/mvnw
!mvn/wrapper/mvnw.cmd

# Gradle files
.gradle/
!gradle-wrapper.jar
gradle-wrapper.jar

# User-specific files
*.user
*.prefs

# Security-related files
.keystore
.truststore

